# Copia este archivo como .env y completa tus valores.
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Meta / WhatsApp Cloud API
META_VERIFY_TOKEN=cambia-este-token-por-uno-secreto
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# Usa la versión vigente que indique Meta para tu aplicación.
META_GRAPH_VERSION=v23.0
# Personalización
BUSINESS_NAME=Mi negocio
PORT=3000
WEBHOOK_PATH=/webhook/whatsapp
# Opcional: sustituye las instrucciones completas del asistente.
# ASSISTANT_INSTRUCTIONS=Eres el asistente de Mi negocio. Responde en español...
